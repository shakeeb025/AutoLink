@using AutoLink.Shared.DTOs

<div class="image-gallery-container apple-card overflow-hidden">
    <!-- Main Display Image Viewport -->
    <div class="main-image-viewport position-relative" style="height: 460px; background-color: #08080A; overflow: hidden;">
        <img src="@SelectedImageUrl" alt="Vehicle preview" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" />
        
        @if (Images.Count > 1)
        {
            <!-- Perfectly Aligned Navigation Chevrons -->
            <div style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); z-index: 10;">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIosNew"
                               Variant="Variant.Filled"
                               Color="Color.Default"
                               Class="bg-dark-blur text-white apple-pill shadow-lg hover-elevate"
                               Style="width: 44px; height: 44px; border: 1px solid rgba(255, 255, 255, 0.2);"
                               OnClick="PreviousImage"
                               aria-label="Previous Image" />
            </div>

            <div style="position: absolute; top: 50%; right: 16px; transform: translateY(-50%); z-index: 10;">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForwardIos"
                               Variant="Variant.Filled"
                               Color="Color.Default"
                               Class="bg-dark-blur text-white apple-pill shadow-lg hover-elevate"
                               Style="width: 44px; height: 44px; border: 1px solid rgba(255, 255, 255, 0.2);"
                               OnClick="NextImage"
                               aria-label="Next Image" />
            </div>

            <!-- Counter Badge Pill -->
            <div style="position: absolute; bottom: 16px; right: 16px; z-index: 10;">
                <div class="px-3 py-1 rounded-pill bg-dark-glass text-white font-weight-bold d-flex align-center gap-1.5" style="font-size: 0.8rem; border: 1px solid rgba(255, 255, 255, 0.15);">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Small" />
                    <span>@(SelectedIndex + 1) / @Images.Count</span>
                </div>
            </div>
        }
    </div>

    <!-- Thumbnail Strip -->
    @if (Images.Count > 1)
    {
        <div class="d-flex gap-2 p-3 overflow-x-auto bg-surface" style="border-top: 1px solid rgba(0, 0, 0, 0.06);">
            @for (int i = 0; i < Images.Count; i++)
            {
                int index = i;
                var img = Images[i];
                <div class="thumbnail-item rounded-lg cursor-pointer hover-elevate"
                     style="width: 88px; height: 58px; overflow: hidden; flex-shrink: 0; border-radius: 10px; border: 2px solid @(SelectedIndex == index ? "#E50914" : "rgba(0, 0, 0, 0.08)"); opacity: @(SelectedIndex == index ? "1" : "0.65"); transition: all 0.2s ease;"
                     @onclick="@(() => SelectImage(index))">
                    <img src="@img.ImageUrl" alt="thumb" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<VehicleImageDto> Images { get; set; } = new();

    private int SelectedIndex { get; set; } = 0;

    private string SelectedImageUrl => Images.Count > 0 && SelectedIndex < Images.Count
        ? Images[SelectedIndex].ImageUrl
        : "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=1000";

    protected override void OnParametersSet()
    {
        if (SelectedIndex >= Images.Count)
        {
            SelectedIndex = 0;
        }
    }

    private void SelectImage(int index)
    {
        SelectedIndex = index;
    }

    private void NextImage()
    {
        if (Images.Count > 0)
        {
            SelectedIndex = (SelectedIndex + 1) % Images.Count;
        }
    }

    private void PreviousImage()
    {
        if (Images.Count > 0)
        {
            SelectedIndex = (SelectedIndex - 1 + Images.Count) % Images.Count;
        }
    }
}
