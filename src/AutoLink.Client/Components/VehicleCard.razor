@using AutoLink.Shared.DTOs
@using AutoLink.Shared.Enums
@using AutoLink.Client.Services
@inject NavigationManager Navigation
@inject VehicleService VehicleService
@inject ComparisonService ComparisonService
@inject ISnackbar Snackbar

<MudCard Elevation="0" Class="apple-card vehicle-card h-100 d-flex flex-column hover-elevate" Style="border: 1px solid rgba(0, 0, 0, 0.07);">
    <!-- Vehicle Image Viewport (Fixed Proportions) -->
    <div class="position-relative" style="height: 200px; overflow: hidden; background-color: #08080A;">
        <img src="@Vehicle.PrimaryImageUrl" alt="@Vehicle.Make @Vehicle.Model" class="vehicle-img" style="width: 100%; height: 100%; object-fit: cover;" />
        
        <!-- Status / Featured Badges -->
        <div class="position-absolute top-3 left-3 d-flex gap-1" style="z-index: 2;">
            @if (Vehicle.IsFeatured)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="apple-pill font-weight-bold" Icon="@Icons.Material.Filled.Bolt">Featured</MudChip>
            }
            @if (Vehicle.Status == VehicleStatus.Reserved)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Class="apple-pill font-weight-bold">Reserved</MudChip>
            }
            else if (Vehicle.Status == VehicleStatus.Sold)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="apple-pill font-weight-bold">Sold</MudChip>
            }
        </div>

        <!-- Action Overlays: Favorite & Compare -->
        <div class="position-absolute top-3 right-3 d-flex gap-1" style="z-index: 2;">
            <MudIconButton Icon="@(ComparisonService.IsInComparison(Vehicle.Id) ? Icons.Material.Filled.CompareArrows : Icons.Material.Outlined.CompareArrows)"
                           Color="@(ComparisonService.IsInComparison(Vehicle.Id) ? Color.Primary : Color.Default)"
                           Variant="Variant.Filled"
                           Class="bg-dark-blur shadow-sm apple-pill text-white"
                           Size="Size.Small"
                           aria-label="Compare"
                           OnClick="ToggleComparison" />

            <MudIconButton Icon="@(Vehicle.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                           Color="@(Vehicle.IsFavorite ? Color.Error : Color.Default)"
                           Variant="Variant.Filled"
                           Class="bg-dark-blur shadow-sm apple-pill text-white"
                           Size="Size.Small"
                           aria-label="Favorite"
                           OnClick="ToggleFavoriteAsync" />
        </div>

        <!-- Price Tag Overlay -->
        <div class="position-absolute bottom-3 left-3" style="z-index: 2;">
            <div class="px-3 py-1 rounded-pill bg-dark-glass text-white font-weight-bold" style="font-size: 1.1rem; letter-spacing: -0.02em;">
                $@Vehicle.Price.ToString("N0")
            </div>
        </div>

        @if (MatchScore.HasValue)
        {
            <div class="position-absolute bottom-3 right-3" style="z-index: 2;">
                <AutoLink.Client.Components.MatchScoreBadge Score="MatchScore.Value" Breakdown="MatchBreakdown" />
            </div>
        }
    </div>

    <!-- Content Body (Standardized Structured Layout) -->
    <MudCardContent Class="flex-grow-1 d-flex flex-column pa-4">
        <!-- Dealer & Listed Date Metadata -->
        <div class="d-flex justify-space-between align-center mb-1.5 gap-1">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium text-truncate" Style="font-size: 0.72rem; letter-spacing: 0.02em;">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" Class="me-0.5" Style="font-size: 0.85rem; vertical-align: -2px;" />
                @Vehicle.DealerName
            </MudText>
            
            <div class="d-flex align-center flex-shrink-0" style="font-size: 0.72rem; color: #71717A;">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="me-1" Style="font-size: 0.75rem; vertical-align: -1px; color: #E50914;" />
                <span>@GetListedDateFormatted(Vehicle.CreatedAt)</span>
            </div>
        </div>
        
        <!-- Standardized Fixed Height Title -->
        <div style="height: 46px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;" class="mb-2">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="letter-spacing: -0.015em; line-height: 1.25;" title="@($"{Vehicle.Year} {Vehicle.Make} {Vehicle.Model}")">
                @Vehicle.Year @Vehicle.Make @Vehicle.Model
            </MudText>
        </div>

        <!-- Key Specs Chips -->
        <div class="d-flex flex-wrap gap-1 mb-2">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="apple-pill font-weight-medium" Icon="@Icons.Material.Filled.Speed">
                @Vehicle.Mileage.ToString("N0") mi
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="apple-pill font-weight-medium" Icon="@Icons.Material.Filled.LocalGasStation">
                @Vehicle.FuelType
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Class="apple-pill font-weight-medium" Icon="@Icons.Material.Filled.DirectionsCar">
                @Vehicle.BodyType
            </MudChip>
        </div>
    </MudCardContent>

    <!-- Bottom Actions Anchored at Bottom -->
    <MudCardActions Class="px-4 pb-4 pt-0 mt-auto">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   FullWidth="true"
                   Class="apple-btn py-2"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   OnClick="@(() => Navigation.NavigateTo($"/vehicles/{Vehicle.Id}"))">
            View Details
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public VehicleDto Vehicle { get; set; } = null!;
    [Parameter] public double? MatchScore { get; set; }
    [Parameter] public MatchBreakdownDto? MatchBreakdown { get; set; }
    [Parameter] public EventCallback<int> OnFavoriteToggled { get; set; }

    private string GetListedDateFormatted(DateTime date)
    {
        if (date == default) return "Recently listed";
        var diff = DateTime.UtcNow - date;
        if (diff.TotalHours < 24)
        {
            if (diff.TotalHours < 1) return "Just listed";
            return $"{(int)diff.TotalHours}h ago";
        }
        if (diff.TotalDays < 7)
        {
            return $"{(int)diff.TotalDays}d ago";
        }
        return date.ToString("MMM dd, yyyy");
    }

    private async Task ToggleFavoriteAsync()
    {
        var res = await VehicleService.ToggleFavoriteAsync(Vehicle.Id);
        if (res.Success)
        {
            Vehicle.IsFavorite = res.Data;
            Snackbar.Add(res.Message, Vehicle.IsFavorite ? Severity.Success : Severity.Info);
            await OnFavoriteToggled.InvokeAsync(Vehicle.Id);
        }
        else
        {
            Snackbar.Add(res.Message ?? "Please sign in as a customer to save favorites", Severity.Warning);
        }
    }

    private void ToggleComparison()
    {
        if (ComparisonService.IsInComparison(Vehicle.Id))
        {
            ComparisonService.Remove(Vehicle.Id);
            Snackbar.Add("Removed from comparison tray", Severity.Info);
        }
        else
        {
            if (ComparisonService.Add(Vehicle))
            {
                Snackbar.Add("Added to comparison tray!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Maximum 4 vehicles can be compared at once.", Severity.Warning);
            }
        }
        StateHasChanged();
    }
}
