@page "/"
@using AutoLink.Client.Services
@inject NavigationManager Navigation
@inject VehicleService VehicleService
@inject RecommendationService RecommendationService
@inject DealerService DealerService
@inject SiteConfigService SiteConfigService

<PageTitle>@SiteConfigService.Config.SiteTitle | @SiteConfigService.Config.SiteTagline</PageTitle>

<!-- Enterprise Hero Showcase (Balanced Compact Luxury Layout) -->
<MudPaper Elevation="0" Class="apple-card mb-8 overflow-hidden bg-surface" Style="border: 1px solid rgba(229, 9, 20, 0.15);">
    <MudGrid Spacing="0" Class="align-center">
        <!-- Left Column: Copy, Branding & Value CTAs -->
        <MudItem xs="12" md="7" Class="pa-6 pa-md-10">
            <div class="d-inline-flex align-center gap-2 px-3 py-1 rounded-pill mb-3 bg-primary-subtle border" style="border-color: rgba(229, 9, 20, 0.3) !important;">
                <span class="rounded-circle" style="width: 7px; height: 7px; background-color: #E50914;"></span>
                <span style="font-size: 0.75rem; font-weight: 700; color: #E50914; letter-spacing: 0.05em; text-transform: uppercase;">
                    @SiteConfigService.Config.SiteTagline
                </span>
            </div>

            <MudText Typo="Typo.h3" Class="font-weight-bold mb-3" Style="letter-spacing: -0.03em; line-height: 1.15;">
                @SiteConfigService.Config.HeroHeadline
            </MudText>

            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6" Style="max-width: 580px; line-height: 1.5; font-size: 0.95rem;">
                @SiteConfigService.Config.HeroSubheadline
            </MudText>

            <!-- Quick Action Pills -->
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="apple-btn px-5 py-2.5"
                           StartIcon="@Icons.Material.Filled.DirectionsCar"
                           OnClick="@(() => Navigation.NavigateTo("/discovery"))">
                    Explore Inventory
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Class="apple-btn px-5 py-2.5"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="@(() => Navigation.NavigateTo("/smart-match"))">
                    AI Match Finder
                </MudButton>
            </div>
        </MudItem>

        <!-- Right Column: Dynamic Car Banner with Gradient Fade -->
        <MudItem xs="12" md="5" Class="position-relative" style="height: 320px; min-height: 260px; background-color: #08080A;">
            <img src="@SiteConfigService.Config.HeroBannerImageUrl" 
                 alt="Hero Showcase" 
                 style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
            
            <!-- Left & Bottom Gradient Blends -->
            <div class="position-absolute inset-0 d-none d-md-block" 
                 style="background: linear-gradient(90deg, var(--mud-palette-surface, #FFFFFF) 0%, transparent 40%), linear-gradient(180deg, transparent 60%, rgba(8, 8, 10, 0.4) 100%); pointer-events: none;"></div>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Quick Search Capsule -->
<MudPaper Elevation="0" Class="apple-card pa-4 mb-10 bg-surface" Style="border: 1px solid rgba(0, 0, 0, 0.07);">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="4">
            <MudTextField T="string"
                          @bind-Value="_searchQuery"
                          Placeholder="Search make, model, keyword..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          OnKeyUp="@(async (e) => { if (e.Key == "Enter") SearchVehicles(); })"
                          Class="apple-pill" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="BodyType?" @bind-Value="_selectedBody" Placeholder="All Body Styles" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (BodyType bt in Enum.GetValues(typeof(BodyType)))
                {
                    <MudSelectItem Value="@((BodyType?)bt)">@bt</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="FuelType?" @bind-Value="_selectedFuel" Placeholder="All Fuel Types" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (FuelType ft in Enum.GetValues(typeof(FuelType)))
                {
                    <MudSelectItem Value="@((FuelType?)ft)">@ft</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="apple-btn"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchVehicles"
                       Style="height: 40px;">
                Search
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Platform Value Proposition Cards (Clickable) -->
<MudGrid Class="mb-12" Spacing="4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="apple-card pa-6 d-flex flex-column h-100 hover-elevate cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/discovery"))">
            <div class="pa-3 rounded-circle bg-primary-subtle d-inline-flex align-center justify-center mb-4" style="width: 48px; height: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Primary" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Multi-Dealer Network</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Compare certified inventories across independent and franchise dealerships in real-time.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="apple-card pa-6 d-flex flex-column h-100 hover-elevate cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/smart-match"))">
            <div class="pa-3 rounded-circle bg-secondary-subtle d-inline-flex align-center justify-center mb-4" style="width: 48px; height: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">AI Smart Match</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Weighted multi-variable algorithm scores vehicles based on budget, year & specs.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="apple-card pa-6 d-flex flex-column h-100 hover-elevate cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/discovery"))">
            <div class="pa-3 rounded-circle bg-success-subtle d-inline-flex align-center justify-center mb-4" style="width: 48px; height: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Color="Color.Success" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Instant Test Drives</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Book test drive slots with dealers directly without hassle or intermediary delays.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Class="apple-card pa-6 d-flex flex-column h-100 hover-elevate cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/register-seller"))">
            <div class="pa-3 rounded-circle bg-warning-subtle d-inline-flex align-center justify-center mb-4" style="width: 48px; height: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Warning" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">Dealer SaaS Hub</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Dealership CRM for inventory management, test drive scheduling, and lead conversions.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Featured Inventory Section -->
<div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-2">
    <div>
        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="letter-spacing: -0.02em;">Featured Arrivals</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Hand-picked premium listings from verified platform dealerships</MudText>
    </div>
    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="apple-btn" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => Navigation.NavigateTo("/discovery"))">
        Explore All Inventory
    </MudButton>
</div>

@if (_loading)
{
    <div class="d-flex justify-center my-12">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    <MudGrid Class="mb-12" Spacing="4">
        @foreach (var vehicle in _featuredVehicles)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <AutoLink.Client.Components.VehicleCard Vehicle="vehicle" />
            </MudItem>
        }
    </MudGrid>
}

<!-- AI Smart Match Feature Card (Enterprise Frosted Banner) -->
<MudPaper Elevation="0" Class="apple-card pa-8 pa-md-12 my-12 position-relative overflow-hidden bg-surface" 
          style="background: radial-gradient(circle at bottom left, rgba(229, 9, 20, 0.10), transparent 70%), linear-gradient(135deg, rgba(248, 250, 252, 0.9) 0%, rgba(255, 255, 255, 0.95) 100%); border: 1px solid rgba(229, 9, 20, 0.15);">
    <MudGrid Class="align-center">
        <MudItem xs="12" md="8">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="font-weight-bold" Style="letter-spacing: -0.02em;">Can't Decide? Let AI Match Your Ideal Vehicle</MudText>
            </div>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6" Style="line-height: 1.6;">
                Set your target budget, body styles, powertrain preferences, and year range. Our weighted matching engine scores and ranks every available vehicle in real-time.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="apple-btn px-6"
                       StartIcon="@Icons.Material.Filled.Bolt"
                       OnClick="@(() => Navigation.NavigateTo("/smart-match"))">
                Launch Smart Match Engine
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="4" Class="text-center d-none d-md-block">
            <div class="pa-8 rounded-circle bg-primary-subtle d-inline-block">
                <MudIcon Icon="@Icons.Material.Filled.Speed" Style="font-size: 5.5rem;" Color="Color.Primary" />
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Certified Dealerships Network -->
<div class="mb-10">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold" Style="letter-spacing: -0.02em;">Partner Dealerships</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Explore top-rated verified automotive retailers on AutoLink</MudText>
        </div>
    </div>

    <MudGrid Spacing="4">
        @foreach (var dealer in _dealers)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0" Class="apple-card h-100 pa-6 d-flex flex-column justify-space-between hover-elevate">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Size="Size.Large" Color="Color.Primary" Class="apple-pill font-weight-bold">
                                @if (!string.IsNullOrEmpty(dealer.LogoUrl))
                                {
                                    <MudImage Src="@dealer.LogoUrl" Alt="@dealer.BusinessName" />
                                }
                                else
                                {
                                    @dealer.BusinessName.FirstOrDefault()
                                }
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@dealer.BusinessName</MudText>
                                <div class="d-flex align-center gap-1">
                                    <MudRating SelectedValue="@((int)Math.Round(dealer.Rating))" ReadOnly="true" Size="Size.Small" Color="Color.Tertiary" />
                                    <MudText Typo="Typo.caption" Class="font-weight-bold">@dealer.Rating.ToString("0.0")</MudText>
                                </div>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 text-truncate-2">
                            @dealer.Description
                        </MudText>
                    </div>

                    <div class="d-flex justify-space-between align-center mt-3 pt-3 border-t">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="vertical-sub" /> @dealer.City
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="apple-btn" OnClick="@(() => Navigation.NavigateTo($"/discovery?search={Uri.EscapeDataString(dealer.BusinessName)}"))">
                            @dealer.ActiveListingsCount Vehicles →
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    private bool _loading = true;
    private string _searchQuery = string.Empty;
    private BodyType? _selectedBody;
    private FuelType? _selectedFuel;
    private List<VehicleDto> _featuredVehicles = new();
    private List<DealerProfileDto> _dealers = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var vehicleRes = await VehicleService.GetVehiclesAsync(new VehicleFilterDto { PageSize = 8 });
        if (vehicleRes.Success && vehicleRes.Data != null)
        {
            _featuredVehicles = vehicleRes.Data.Items;
        }

        var dealerRes = await DealerService.GetDealersAsync();
        if (dealerRes.Success && dealerRes.Data != null)
        {
            _dealers = dealerRes.Data.Take(3).ToList();
        }
        _loading = false;
    }

    private void SearchVehicles()
    {
        var url = "/discovery?";
        if (!string.IsNullOrWhiteSpace(_searchQuery)) url += $"search={Uri.EscapeDataString(_searchQuery)}&";
        if (_selectedBody.HasValue) url += $"bodyType={(int)_selectedBody.Value}&";
        if (_selectedFuel.HasValue) url += $"fuelType={(int)_selectedFuel.Value}&";

        Navigation.NavigateTo(url.TrimEnd('&', '?'));
    }
}
